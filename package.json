{
  "name": "faldone",
  "private": true,
  "description": "Il Faldone: atlante operativo dell'infrastruttura di casa, laboratorio e Vito",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node tools/build.mjs",
    "check": "node tools/build.mjs --check",
    "test": "node tools/build.mjs && node --test tools/test/*.test.mjs",
    "serve": "python3 -m http.server 8811 --bind 127.0.0.1",
    "e2e": "node tools/e2e/smoke.cjs && node tools/e2e/a11y.cjs",
    "migrate": "node tools/migrate-legacy.mjs"
  }
}
